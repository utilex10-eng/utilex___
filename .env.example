# ==============================================================================
# UTILEX — Production Environment Configuration
# Copy this file to .env and configure with your real values.
# NEVER commit your real .env file with secrets to Git.
# ==============================================================================

# Server Environment ('development' | 'production')
NODE_ENV=production

# Server Port (Default is 3000, cloud providers provide their own via process.env.PORT)
PORT=3000

# Canonical Application & Frontend URL
APP_URL=https://utilex.com
FRONTEND_URL=https://utilex.com

# PostgreSQL / Supabase Database Connection String (Optional for local dev, recommended for production)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Session & Token Secret (Used for cryptographic token generation)
SESSION_SECRET=your_long_random_cryptographic_secret_here

# Google Gemini API Key (Server-side only — powers UTILEX AI Chat and the 10 AI utility tools)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Contact Email & SMTP Configuration
# Contact form submissions will be securely delivered to this administrative email:
CONTACT_RECEIVER_EMAIL=utilex10@gmail.com

# SMTP Server Credentials (Required for actual email delivery; e.g. Resend, SendGrid, Amazon SES, Brevo, Gmail SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password_or_api_key_here
SMTP_FROM="UTILEX Notifications <utilex10@gmail.com>"
